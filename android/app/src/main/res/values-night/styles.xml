<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- A dark app theme at night also tells the WebView to report
         prefers-color-scheme: dark, so the page picks its own dark theme. -->
    <style name="Fairsix" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    <color name="ground">#0C1A1E</color>
</resources>
